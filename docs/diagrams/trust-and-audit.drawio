le="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1214.0" y="241.5" width="162" height="56.0" as="geometry"/></mxCell><mxCell id="c75" value="" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#14B8A6;strokeWidth=1.6;shadow=0;" vertex="1" parent="1"><mxGeometry x="1385" y="190" width="155" height="112" as="geometry"/></mxCell><mxCell id="c76" value="Control plane spool" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=12.5;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1399.0" y="208.5" width="147" height="16.2" as="geometry"/></mxCell><mxCell id="c77" value="Source for every sink.&lt;br&gt;A gap in a producer's&lt;br&gt;seq number shows&lt;br&gt;as a dashboard alert." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1399.0" y="241.5" width="143" height="56.0" as="geometry"/></mxCell><mxCell id="c78" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#1F2A44;strokeWidth=2.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="990" y="246" as="sourcePoint"/><mxPoint x="1015" y="246" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c79" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#1F2A44;strokeWidth=2.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1175" y="246" as="sourcePoint"/><mxPoint x="1200" y="246" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c80" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#1F2A44;strokeWidth=2.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="246" as="sourcePoint"/><mxPoint x="1385" y="246" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c81" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=none;endFill=1;startArrow=none;startFill=1;strokeColor=#5B6B7F;strokeWidth=2.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1462" y="302" as="sourcePoint"/><mxPoint x="1462" y="332" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c82" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=none;endFill=1;startArrow=none;startFill=1;strokeColor=#5B6B7F;strokeWidth=2.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="955" y="332" as="sourcePoint"/><mxPoint x="1462" y="332" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c83" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#5B6B7F;strokeWidth=2.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="955" y="332" as="sourcePoint"/><mxPoint x="955" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c84" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#5B6B7F;strokeWidth=2.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="332" as="sourcePoint"/><mxPoint x="1190" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c85" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#5B6B7F;strokeWidth=2.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460" y="332" as="sourcePoint"/><mxPoint x="1460" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c86" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#7AA116;strokeWidth=1.6;shadow=0;" vertex="1" parent="1"><mxGeometry x="830" y="366" width="250" height="126" as="geometry"/></mxCell><mxCell id="c87" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="840" y="376" width="34" height="34" as="geometry"/></mxCell><mxCell id="c88" value="S3: event batches" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=12.5;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="884.0" y="384.5" width="133" height="16.2" as="geometry"/></mxCell><mxCell id="c89" value="JSONL.gz every 5 MiB or 60 s,&lt;br&gt;SSE-KMS, optional Object Lock.&lt;br&gt;Each batch has a manifest&lt;br&gt;signed by the control plane and&lt;br&gt;chained to the previous one." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="844.0" y="417.5" width="198" height="70.0" as="geometry"/></mxCell><mxCell id="c90" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#7AA116;strokeWidth=1.6;shadow=0;" vertex="1" parent="1"><mxGeometry x="1090" y="366" width="200" height="126" as="geometry"/></mxCell><mxCell id="c91" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1100" y="376" width="34" height="34" as="geometry"/></mxCell><mxCell id="c92" value="S3: recordings" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=12.5;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1144.0" y="384.5" width="111" height="16.2" as="geometry"/></mxCell><mxCell id="c93" value="Terminal and session&lt;br&gt;recordings, stored with&lt;br&gt;their SHA-256. A changed&lt;br&gt;recording will not play." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1104.0" y="417.5" width="156" height="56.0" as="geometry"/></mxCell><mxCell id="c94" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#632CA6;strokeWidth=1.6;shadow=0;" vertex="1" parent="1"><mxGeometry x="1300" y="366" width="250" height="126" as="geometry"/></mxCell><mxCell id="c95" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1310" y="376" width="34" height="34" as="geometry"/></mxCell><mxCell id="c96" value="Datadog (optional)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=12.5;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1354.0" y="384.5" width="140" height="16.2" as="geometry"/></mxCell><mxCell id="c97" value="Logs intake, plus monitors and&lt;br&gt;metrics. May see rare duplicates&lt;br&gt;under failure." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1314.0" y="417.5" width="204" height="42.0" as="geometry"/></mxCell><mxCell id="c98" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#5B6B7F;strokeWidth=2.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="955" y="492" as="sourcePoint"/><mxPoint x="955" y="546" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c99" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#8C4FFF;strokeWidth=1.6;shadow=0;" vertex="1" parent="1"><mxGeometry x="830" y="546" width="250" height="100" as="geometry"/></mxCell><mxCell id="c100" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="840" y="556" width="34" height="34" as="geometry"/></mxCell><mxCell id="c101" value="Athena" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=12.5;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="884.0" y="564.5" width="53" height="16.2" as="geometry"/></mxCell><mxCell id="c102" value="SQL over the audit trail,&lt;br&gt;duplicates removed by event_id." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="844.0" y="597.5" width="198" height="28.0" as="geometry"/></mxCell><mxCell id="c103" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#5B6B7F;strokeWidth=2.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="596" as="sourcePoint"/><mxPoint x="1110" y="596" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c104" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#ED7100;strokeWidth=1.6;shadow=0;" vertex="1" parent="1"><mxGeometry x="1110" y="546" width="240" height="100" as="geometry"/></mxCell><mxCell id="c105" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1120" y="556" width="34" height="34" as="geometry"/></mxCell><mxCell id="c106" value="Grafana (on ECS)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=12.5;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1164.0" y="564.5" width="125" height="16.2" as="geometry"/></mxCell><mxCell id="c107" value="Who accessed what, denied&lt;br&gt;attempts, active sessions,&lt;br&gt;ingestion lag, seq gaps." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1124.0" y="597.5" width="168" height="42.0" as="geometry"/></mxCell><mxCell id="c108" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#ED7100;strokeWidth=1.6;shadow=0;" vertex="1" parent="1"><mxGeometry x="1370" y="546" width="180" height="100" as="geometry"/></mxCell><mxCell id="c109" value="Fails closed" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=12.5;fontColor=#9A3412;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1384.0" y="559.5" width="97" height="16.2" as="geometry"/></mxCell><mxCell id="c110" value="Spool full or sink&lt;br&gt;down: no new sessions&lt;br&gt;and no logins. Nothing&lt;br&gt;is dropped silently." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1384.0" y="581.5" width="143" height="56.0" as="geometry"/></mxCell><mxCell id="c111" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#14B8A6;strokeWidth=1.4;shadow=0;" vertex="1" parent="1"><mxGeometry x="830" y="686" width="720" height="56" as="geometry"/></mxCell><mxCell id="c112" value="Verify any time" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=12.5;fontColor=#0F766E;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="846.0" y="697.5" width="118" height="16.2" as="geometry"/></mxCell><mxCell id="c113" value="limen-audit-verify walks every writer's chain and reports a missing, reordered, modified or unsigned batch." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="846.0" y="717.0" width="692" height="14.3" as="geometry"/></mxCell><mxCell id="c114" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#CBD5E1;strokeWidth=1.4;shadow=0;" vertex="1" parent="1"><mxGeometry x="30" y="790" width="1540" height="440" as="geometry"/></mxCell><mxCell id="c115" value="What keeps working when something is down" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=16;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50.0" y="804.0" width="390" height="2