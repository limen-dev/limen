2F3E;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50.0" y="668.0" width="204" height="15.6" as="geometry"/></mxCell><mxCell id="c57" value="internal CA · renewed at 50%" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10;fontColor=#5B6B7F;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50.0" y="684.0" width="172" height="13.0" as="geometry"/></mxCell><mxCell id="c58" value="" style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#1F2A44;strokeColor=none;strokeWidth=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="300" y="672" width="298.4608118280962" height="18" as="geometry"/></mxCell><mxCell id="c59" value="24 hours" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="608.5" y="674.5" width="63" height="15.0" as="geometry"/></mxCell><mxCell id="c60" value="A stolen credential is useless within minutes. Lock or kill-session ends access sooner." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#0F766E;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50.0" y="728.5" width="590" height="15.0" as="geometry"/></mxCell><mxCell id="c61" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#CBD5E1;strokeWidth=1.4;shadow=0;" vertex="1" parent="1"><mxGeometry x="810" y="120" width="760" height="650" as="geometry"/></mxCell><mxCell id="c62" value="Audit: written before access is allowed to continue" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;