oint"/></mxGeometry></mxCell><mxCell id="c183" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=none;endFill=1;startArrow=block;startFill=1;strokeColor=#5B6B7F;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="792" y="826" as="sourcePoint"/><mxPoint x="828" y="826" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c184" value="queries" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10;fontColor=#5B6B7F;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="645.0" y="810.0" width="50" height="13.0" as="geometry"/></mxCell><mxCell id="c185" value="reads" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10;fontColor=#5B6B7F;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="790.0" y="810.0" width="40" height="13.0" as="geometry"/></mxCell><mxCell id="c186" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#5B6B7F;strokeWidth=2.0;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1002" y="520" as="sourcePoint"/><mxPoint x="1000" y="800" as="targetPoint"/><Array as="points"><mxPoint x="1030" y="520"/><mxPoint x="1030" y="790"/><mxPoint x="1000" y="790"/></Array></mxGeometry></mxCell><mxCell id="c187" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#14B8A6;strokeWidth=2.6;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1148" y="239" as="sourcePoint"/><mxPoint x="815" y="334" as="targetPoint"/><Array as="points"><mxPoint x="1105" y="239"/><mxPoint x="1105" y="334"/></Array></mxGeometry></mxCell><mxCell id="c188" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=none;endFill=1;startArrow=block;startFill=1;strokeColor=#14B8A6;strokeWidth=2.6;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1148" y="671" as="sourcePoint"/><mxPoint x="1105" y="239" as="targetPoint"/><Array as="points"><mxPoint x="1105" y="671"/></Array></mxGeometry></mxCell><mxCell id="c189" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14B8A6;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1094" y="285" width="22" height="22" as="geometry"/></mxCell><mxCell id="c190" value="Workers dial out; sessions" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#0F766E;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="850.0" y="287.5" width="168" height="13.7" as="geometry"/></mxCell><mxCell id="c191" value="ride the same tunnel" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#0F766E;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="850.0" y="300.5" width="131" height="13.7" as="geometry"/></mxCell><mxCell id="c192" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F2A44;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1335" y="161" width="22" height="22" as="geometry"/></mxCell><mxCell id="c193" value="The path of one connection" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=15;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30.0" y="947.0" width="236" height="19.5" as="geometry"/></mxCell><mxCell id="c194" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#CBD5E1;strokeWidth=1.2;shadow=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="978" width="245.0" height="128" as="geometry"/></mxCell><mxCell id="c195" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F2A44;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="41.0" y="991" width="26" height="26" as="geometry"/></mxCell><mxCell id="c196" value="Log in with your IdP" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=13.5;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="76.0" y="995.5" width="166" height="17.6" as="geometry"/></mxCell><mxCell id="c197" value="limen login signs you in through&lt;br&gt;your identity provider (OIDC with&lt;br&gt;PKCE). The key pair is made on your&lt;br&gt;laptop and never leaves it." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46.0" y="1024.5" width="213" height="62.0" as="geometry"/></mxCell><mxCell id="c198" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#CBD5E1;strokeWidth=1.2;shadow=0;" vertex="1" parent="1"><mxGeometry x="289.0" y="978" width="245.0" height="128" as="geometry"/></mxCell><mxCell id="c199" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F2A44;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300.0" y="991" width="26" height="26" as="geometry"/></mxCell><mxCell id="c200" value="Get a 1-hour certificate" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=13.5;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="335.0" y="995.5" width="221" height="17.6" as="geometry"/></mxCell><mxCell id="c201" value="The control plane checks the token,&lt;br&gt;maps IdP groups to roles, and signs&lt;br&gt;a short-lived X.509 certificate with&lt;br&gt;a key held in KMS." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="305.0" y="1024.5" width="213" height="62.0" as="geometry"/></mxCell><mxCell id="c202" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#CBD5E1;strokeWidth=1.2;shadow=0;" vertex="1" parent="1"><mxGeometry x="548.0" y="978" width="245.0" height="128" as="geometry"/></mxCell><mxCell id="c203" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F2A44;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="559.0" y="991" width="26" height="26" as="geometry"/></mxCell><mxCell id="c204" value="Connect through one door" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=13.5;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="594.0" y="995.5" width="197" height="17.6" as="geometry"/></mxCell><mxCell id="c205" value="ssh, psql, kubectl or a browser open&lt;br&gt;mTLS to the NLB on port 443. The&lt;br&gt;proxy checks policy and signs a&lt;br&gt;60-second session grant." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="564.0" y="1024.5" width="213" height="62.0" as="geometry"/></mxCell><mxCell id="c206" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#CBD5E1;strokeWidth=1.2;shadow=0;" vertex="1" parent="1"><mxGeometry x="807.0" y="978" width="245.0" height="128" as="geometry"/></mxCell><mxCell id="c207" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F2A44;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="818.0" y="991" width="26" height="26" as="geometry"/></mxCell><mxCell id="c208" value="Workers dial out" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=13.5;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="853.0" y="995.5" width="135" height="17.6" as="geometry"/></mxCell><mxCell id="c209" value="Workers sit next to your targets and&lt;br&gt;open an outbound tunnel to the&lt;br&gt;proxies. No inbound port, no public&lt;br&gt;database, no bastion." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="823.0" y="1024.5" width="213" height="62.0" as="geometry"/></mxCell><mxCell id="c210" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#CBD5E1;strokeWidth=1.2;shadow=0;" vertex="1" parent="1"><mxGeometry x="1066.0" y="978" width="245.0" height="128" as="geometry"/></mxCell><mxCell id="c211" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F2A44;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1077.0" y="991" width="26" height="26" as="geometry"/></mxCell><mxCell id="c212" value="Use a per-session credential" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=13.5;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1112.0" y="995.5" width="229" height="17.6" as="geometry"/></mxCell><mxCell id="c213" value="The worker re-checks the grant, then&lt;br&gt;reaches the target with a credential&lt;br&gt;made for this session: IAM token,&lt;br&gt;SSH certificate, or impersonation." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1082.0" y="1024.5" width="213" height="62.0" as="geometry"/></mxCell><mxCell id="c214" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#CBD5E1;strokeWidth=1.2;shadow=0;" vertex="1" parent="1"><mxGeometry x="1325.0" y="978" width="245.0" height="128" as="geometry"/></mxCell><mxCell id="c215" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F2A44;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1336.0" y="991" width="26" height="26" as="geometry"/></mxCell><mxCell id="c216" value="Everything is audited" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=13.5;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1371.0" y="995.5" width="174" height="17.6" as="geometry"/></mxCell><mxCell id="c217" value="Sessions, commands and denials become&lt;br&gt;events. They are spooled, hash-chained,&lt;br&gt;and shipped to S3. If audit cannot be&lt;br&gt;written, access fails closed." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1341.0" y="1024.5" width="213" height="62.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
