=0;fontSize=11.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="640.0" y="408.5" width="156" height="15.0" as="geometry"/></mxCell><mxCell id="c69" value="the proxy relays it, and cannot swap in its own keys" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#5B6B7F;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="555.0" y="436.5" width="326" height="13.7" as="geometry"/></mxCell><mxCell id="c70" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#14B8A6;strokeWidth=1.4;shadow=0;" vertex="1" parent="1"><mxGeometry x="850.0" y="456" width="300" height="62" as="geometry"/></mxCell><mxCell id="c71" value="Verify token, map IdP groups to roles,&lt;br&gt;sign with the CA key in KMS&lt;br&gt;audit: auth.login" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="879.5" y="463.5" width="241" height="42.0" as="geometry"/></mxCell><mxCell id="c72" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#1F2A44;strokeWidth=2.3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="548" as="sourcePoint"/><mxPoint x="420" y="548" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c73" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F2A44;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="429" y="520" width="22" height="22" as="geometry"/></mxCell><mxCell id="c74" value="10-minute X.509 certificate" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="623.0" y="524.5" width="190" height="15.0" as="geometry"/></mxCell><mxCell id="c75" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#1F2A44;strokeWidth=2.3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="672" as="sourcePoint"/><mxPoint x="710" y="672" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c76" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F2A44;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="429" y="644" width="22" height="22" as="geometry"/></mxCell><mxCell id="c77" value="mTLS with your certificate" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="481.5" y="648.5" width="183" height="15.0" as="geometry"/></mxCell><mxCell id="c78" value="SessionRequest: resource, login or DB role" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#5B6B7F;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="440.5" y="676.5" width="265" height="13.7" as="geometry"/></mxCell><mxCell id="c79" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#14B8A6;strokeWidth=1.4;shadow=0;" vertex="1" parent="1"><mxGeometry x="540.0" y="697" width="340" height="62" as="geometry"/></mxCell><mxCell id="c80" value="Valid certificate? Policy allows? (signed snapshot)&lt;br&gt;No: audit auth.denied, close&lt;br&gt;Yes: sign a 60-second session grant, audit session.start" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="534.5" y="704.5" width="351" height="42.0" as="geometry"/></mxCell><mxCell id="c81" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#14B8A6;strokeWidth=2.3;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="802" as="sourcePoint"/><mxPoint x="1270" y="802" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c82" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14B8A6;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="719" y="774" width="22" height="22" as="geometry"/></mxCell><mxCell id="c83" value="Stream over the worker's outbound tunnel" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="860.0" y="778.5" width="276" height="15.0" as="geometry"/></mxCell><mxCell id="c84" value="with the signed grant (via a peer proxy if needed)" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#5B6B7F;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="841.0" y="806.5" width="314" height="13.7" as="geometry"/></mxCell><mxCell id="c85" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#14B8A6;strokeWidth=1.4;shadow=0;" vertex="1" parent="1"><mxGeometry x="1125.0" y="824" width="290" height="76" as="geometry"/></mxCell><mxCell id="c86" value="Grant signature and expiry OK?&lt;br&gt;Own policy copy allows too? (both must)&lt;br&gt;Labels match the resource?&lt;br&gt;Then get the upstream credential" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1146.5" y="831.5" width="247" height="56.0" as="geometry"/></mxCell><mxCell id="c87" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#1F2A44;strokeWidth=2.3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1270" y="938" as="sourcePoint"/><mxPoint x="1500" y="938" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c88" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F2A44;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1279" y="910" width="22" height="22" as="geometry"/></mxCell><mxCell id="c89" value="Connects with a credential made for this session" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="926.0" y="923.5" width="330" height="15.0" as="geometry"/></mxCell><mxCell id="c90" value="SSH certificate (1 min) · IAM token · kube impersonation" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#5B6B7F;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="905.0" y="940.5" width="351" height="13.7" as="geometry"/></mxCell><mxCell id="c91" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#14B8A6;strokeWidth=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="992" as="sourcePoint"/><mxPoint x="1500" y="992" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c92" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#14B8A6;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="429" y="964" width="22" height="22" as="geometry"/></mxCell><mxCell id="c93" value="Your session: end-to-end through the proxy and worker, which the worker records" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#0F766E;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700.0" y="968.5" width="536" height="15.0" as="geometry"/></mxCell><mxCell id="c94" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#5B6B7F;strokeWidth=2.3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1270" y="1112" as="sourcePoint"/><mxPoint x="1000" y="1112" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c95" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#5B6B7F;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1009" y="1084" width="22" height="22" as="geometry"/></mxCell><mxCell id="c96" value="Commands, queries and the recording, as audit events" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="630.0" y="1097.5" width="356" height="15.0" as="geometry"/></mxCell><mxCell id="c97" value="spooled to disk first, then relayed through the proxy" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#5B6B7F;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="654.0" y="1114.5" width="332" height="13.7" as="geometry"/></mxCell><mxCell id="c98" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#ED7100;strokeWidth=1.4;shadow=0;" vertex="1" parent="1"><mxGeometry x="845.0" y="1136" width="310" height="62" as="geometry"/></mxCell><mxCell id="c99" value="Append to the hash chain, write batches to S3&lt;br&gt;(signed manifests), optionally to Datadog&lt;br&gt;If audit cannot be written: no new sessions" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="858.0" y="1143.5" width="284" height="42.0" as="geometry"/></mxCell><mxCell id="c100" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#ED7100;strokeWidth=1.4;shadow=0;" vertex="1" parent="1"><mxGeometry x="585.0" y="1136" width="250" height="48" as="geometry"/></mxCell><mxCell id="c101" value="Session ends: audit session.end&lt;br&gt;duration, bytes, reason" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="611.0" y="1143.5" width="198" height="28.0" as="geometry"/></mxCell><mxCell id="c102" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DD344C;strokeWidth=1.4;shadow=0;" vertex="1" parent="1"><mxGeometry x="295.0" y="1136" width="250" height="48" as="geometry"/></mxCell><mxCell id="c103" value="limen admin lock / kill-session&lt;br&gt;ends access at once" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=10.5;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="321.0" y="1143.5" width="198" height="28.0" as="geometry"/></mxCell><mxCell id="c104" value="Three things to remember" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=15;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30.0" y="1237.0" width="218" height="19.5" as="geometry"/></mxCell><mxCell id="c105" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#CBD5E1;strokeWidth=1.2;shadow=0;" vertex="1" parent="1"><mxGeometry x="30" y="1267" width="500" height="95" as="geometry"/></mxCell><mxCell id="c106" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#14B8A6;strokeColor=none;strokeWidth=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="30" y="1267" width="6" height="95" as="geometry"/></mxCell><mxCell id="c107" value="Nothing is long-lived" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=13.5;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="52.0" y="1276.5" width="174" height="17.6" as="geometry"/></mxCell><mxCell id="c108" value="Certificate 10 min, session grant 60 s, SSH certificate 1 min,&lt;br&gt;IAM token for the connect only. A stolen credential is&lt;br&gt;worthless within minutes." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="52.0" y="1299.0" width="405" height="45.0" as="geometry"/></mxCell><mxCell id="c109" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#CBD5E1;strokeWidth=1.2;shadow=0;" vertex="1" parent="1"><mxGeometry x="550" y="1267" width="500" height="95" as="geometry"/></mxCell><mxCell id="c110" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#14B8A6;strokeColor=none;strokeWidth=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="550" y="1267" width="6" height="95" as="geometry"/></mxCell><mxCell id="c111" value="Two independent checks" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=13.5;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="572.0" y="1276.5" width="182" height="17.6" as="geometry"/></mxCell><mxCell id="c112" value="The proxy and the worker each evaluate policy from signed&lt;br&gt;snapshots. A compromised proxy cannot reach a target&lt;br&gt;the worker's policy does not allow." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="572.0" y="1299.0" width="373" height="45.0" as="geometry"/></mxCell><mxCell id="c113" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#CBD5E1;strokeWidth=1.2;shadow=0;" vertex="1" parent="1"><mxGeometry x="1070" y="1267" width="500" height="95" as="geometry"/></mxCell><mxCell id="c114" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#14B8A6;strokeColor=none;strokeWidth=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="1070" y="1267" width="6" height="95" as="geometry"/></mxCell><mxCell id="c115" value="Fail closed" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=13.5;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1092.0" y="1276.5" width="96" height="17.6" as="geometry"/></mxCell><mxCell id="c116" value="No audit, no session. If the control plane or KMS is down,&lt;br&gt;new SSH and logins stop, and database or Kubernetes access&lt;br&gt;continues only within a 5-minute policy grace period." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11;fontColor=#232F3E;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1092.0" y="1299.0" width="380" height="45.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
