<mxfile host="app.diagrams.net"><diagram name="Connection sequence" id="limen"><mxGraphModel dx="1600" dy="1390" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1390" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="168" height="60" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=0;whiteSpace=wrap;html=1;fillColor=#CBD5E1;strokeColor=none;strokeWidth=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="222" y="28" width="2" height="42" as="geometry"/></mxCell><mxCell id="c5" value="What happens when you run  limen ssh prod-db" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=22;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="242.0" y="28.0" width="571" height="28.6" as="geometry"/></mxCell><mxCell id="c6" value="One login, one connection, one audit trail. Every credential in the path is short-lived and every step is checked twice" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=13;fontColor=#5B6B7F;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="242.0" y="59.0" width="907" height="16.9" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1540" height="327" as="geometry"/></mxCell><mxCell id="c8" value="A. Once per login" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=13.5;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46.0" y="253.5" width="143" height="17.6" as="geometry"/></mxCell><mxCell id="c9" value="You prove who you are and get a certificate that expires in 10 minutes" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11;fontColor=#5B6B7F;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46.0" y="274.0" width="456" height="14.3" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="30" y="587" width="1540" height="430" as="geometry"/></mxCell><mxCell id="c11" value="B. Every connection" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=13.5;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46.0" y="595.5" width="158" height="17.6" as="geometry"/></mxCell><mxCell id="c12" value="Policy is checked at the proxy and again at the worker; the worker connects to the target" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11;fontColor=#5B6B7F;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46.0" y="616.0" width="577" height="14.3" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="30" y="1032" width="1540" height="180" as="geometry"/></mxCell><mxCell id="c14" value="C. During and after" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=13.5;fontColor=#1F2A44;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46.0" y="1040.5" width="158" height="17.6" as="geometry"/></mxCell><mxCell id="c15" value="Everything that happened becomes an audit event before the session is allowed to continue" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;fontSize=11;fontColor=#5B6B7F;fontFamily=Helvetica;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46.0" y="1061.0" width="577" height="14.3" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=none;endFill=1;startArrow=none;startFill=1;strokeColor=#CBD5E1;strokeWidth=1.6;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="232" as="sourcePoint"/><mxPoint x="150" y="1212" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=none;endFill=1;startArrow=none;startFill=1;strokeColor=#CBD5E1;strokeWidth=1.6;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="232" as="sourcePoint"/><mxPoint x="420" y="1212" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=none;endFill=1;startArrow=none;startFill=1;strokeColor=#CBD5E1;strokeWidth=1.6;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="232" as="sourcePoint"/><mxPoint x="710" y="1212" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=none;endFill=1;startArrow=none;startFill=1;strokeColor=#CBD5E1;strokeWidth=1.6;dashed=1;dashPattern=7 5;" edge="1" parent="1">