---
import Site from '../layouts/Site.astro';
import { GH, docsUrl } from '../data/site';

const base = import.meta.env.BASE_URL;
const docs = (p: string) => docsUrl(base, p);

const steps = [
  { n: '01', t: 'Sign in', d: 'Through the identity provider you already run. Your login is tied to a key that never leaves your machine.', c: 'limen login' },
  { n: '02', t: 'Policy decides', d: 'Your IdP groups become roles, and roles reach resources by label. Anything no rule allows is denied, and you can ask why.', c: 'limen explain orders-prod' },
  { n: '03', t: 'Connect', d: 'You get a certificate that lasts an hour, or less if you choose. A worker inside your network dials out to Limen, so your targets open no inbound port.', c: 'limen db connect orders-staging' },
  { n: '04', t: 'Prove', d: 'Every session is recorded or audited into a signed, hash-chained trail. Auditors can search it, and check that nothing in it was changed.', c: 'limen audit search user:alice' },
];

import postgresql from '../assets/logos/postgresql.svg?raw';
import mysql from '../assets/logos/mysql.svg?raw';
import redis from '../assets/logos/redis.svg?raw';
import kubernetes from '../assets/logos/kubernetes.svg?raw';
import mongodb from '../assets/logos/mongodb.svg?raw';
import opensearch from '../assets/logos/opensearch.svg?raw';
import elasticsearch from '../assets/logos/elasticsearch.svg?raw';
import rabbitmq from '../assets/logos/rabbitmq.svg?raw';
import kafka from '../assets/logos/apachekafka.svg?raw';
import githubactions from '../assets/logos/githubactions.svg?raw';
import gitlab from '../assets/logos/gitlab.svg?raw';

// Brand logos are Simple Icons (CC0). The icons without a brand are drawn as strokes.
type Logo = { svg: string; color: string; label: string; wide?: boolean };
const brand = (svg: string, color: string, label: string): Logo => ({ svg: svg.replace(/<title>.*?<\/title>/, '').replace('<svg role="img"', '<svg aria-hidden="true" focusable="false"'), color, label, wide: label === 'MySQL' });
const line = (d: string, label: string): Logo => ({ svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`, color: 'var(--lm-accent-strong)', label });
const terminal = line('<rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="m7 9 3 3-3 3M13 15h4"/>', 'Terminal');
const globe = line('<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"/>', 'Web');
const plug = line('<path d="M9 3v5M15 3v5M6 8h12v3a6 6 0 0 1-12 0V8ZM12 17v4"/>', 'TCP');

const svg = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const svgp = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const ico = {
  chain: svg('<rect x="2.5" y="8" width="7" height="8" rx="2"/><rect x="14.5" y="8" width="7" height="8" rx="2"/><path d="M9.5 12h5"/>'),
  test: svg('<path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4A2 2 0 0 0 19 18l-5-9V3"/><path d="m9.5 15 1.8 1.8 3.2-3.6"/>'),
  clock: svg('<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2M9.5 2.5h5"/>'),
  bot: svg('<rect x="4" y="8" width="16" height="11" rx="3"/><path d="M12 8V4M9 13v1M15 13v1"/><circle cx="12" cy="3.5" r="1"/>'),
  rec: svg('<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3" fill="currentColor"/>'),
  pack: svg('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v5h5M9 14.5l2 2 4-4"/>'),
  stop: svg('<circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8"/>'),
  dev: svgp('<rect pathLength="1" x="3" y="4" width="18" height="16" rx="2.5"/><path pathLength="1" d="m7 9 3 3-3 3M13 15h4"/>'),
  ops: svgp('<rect pathLength="1" x="3" y="3.5" width="18" height="7" rx="2"/><rect pathLength="1" x="3" y="13.5" width="18" height="7" rx="2"/><path pathLength="1" d="M7 7h.01M7 17h.01M12 7h5M12 17h5"/>'),
  sec: svgp('<path pathLength="1" d="M12 3 4.5 6v5.5c0 4.6 3.2 8 7.5 9.5 4.3-1.5 7.5-4.9 7.5-9.5V6L12 3Z"/><path pathLength="1" d="m9 12 2.2 2.2L15.5 10"/>'),
  open: svg('<path d="M8 8 3.5 12 8 16M16 8l4.5 4-4.5 4M13.5 5l-3 14"/>'),
};

type Proto = { logos: Logo[]; name: string; sub: string; warn?: string; href: string };
type Group = { id: string; title: string; blurb: string; items: Proto[] };
const groups: Group[] = [
  {
    id: 'servers', title: 'Servers and clusters', blurb: 'Log in to machines and run commands.',
    items: [
      { logos: [terminal], name: 'SSH', sub: 'Per-session certificates, recorded and replayable', href: 'guides/cli/' },
      { logos: [brand(kubernetes, '#326CE5', 'Kubernetes')], name: 'Kubernetes', sub: 'Impersonation, recorded exec', warn: 'EKS. Works on kind', href: 'guides/kubernetes/' },
    ],
  },
  {
    id: 'databases', title: 'Databases', blurb: 'Every statement is audited.',
    items: [
      { logos: [brand(postgresql, '#4169E1', 'PostgreSQL')], name: 'PostgreSQL', sub: 'RDS, Aurora, Redshift. Every statement audited', warn: 'IAM and Redshift on AWS', href: 'guides/databases/' },
      { logos: [brand(mysql, '#4479A1', 'MySQL')], name: 'MySQL', sub: 'RDS and Aurora. Every statement audited', warn: 'IAM on AWS', href: 'guides/databases/' },
      { logos: [brand(mongodb, '#47A248', 'MongoDB')], name: 'MongoDB', sub: 'Any server, Atlas, DocumentDB', warn: 'Atlas and DocumentDB', href: 'guides/mongodb/' },
      { logos: [brand(redis, '#FF4438', 'Redis')], name: 'Redis and Valkey', sub: 'Values redacted in audit', warn: 'ElastiCache IAM', href: 'guides/redis/' },
      { logos: [brand(opensearch, '#005EB8', 'OpenSearch'), brand(elasticsearch, '#005571', 'Elasticsearch')], name: 'OpenSearch and Elasticsearch', sub: 'Policy by index pattern', warn: 'Amazon OpenSearch and Elastic Cloud', href: 'guides/search/' },
    ],
  },
  {
    id: 'messaging', title: 'Message brokers', blurb: 'Message bodies never reach the audit log.',
    items: [
      { logos: [brand(kafka, '#231F20', 'Kafka')], name: 'Kafka', sub: 'Record values never audited', warn: 'MSK and IAM', href: 'guides/messaging/' },
      { logos: [brand(rabbitmq, '#FF6600', 'RabbitMQ')], name: 'RabbitMQ', sub: 'No message bodies in audit', warn: 'Amazon MQ', href: 'guides/messaging/' },
    ],
  },
  {
    id: 'apps', title: 'Apps, networks and automation', blurb: 'Everything else, and your pipelines.',
    items: [
      { logos: [globe], name: 'Internal web apps', sub: 'SSO in front of any web UI, every request audited', href: 'guides/web-apps/' },
      { logos: [plug], name: 'Raw TCP', sub: 'Anything else, through a local port', href: 'guides/tcp/' },
      { logos: [brand(githubactions, '#2088FF', 'GitHub Actions'), brand(gitlab, '#FC6D26', 'GitLab')], name: 'CI bots', sub: 'GitHub Actions, GitLab CI, any OIDC. No long-lived secrets', warn: 'Real CI tokens. Tested with a stand-in', href: 'guides/bots/' },
    ],
  },
];
const consolePages = [
  { id: 'overview', t: 'Overview', alt: 'The console overview: live counts, and every resource you can reach with a copy-paste command.', cap: 'Who you are, what you can reach, and a copy-paste command for each resource. Admins also get live counts.' },
  { id: 'resources', t: 'Resources', alt: 'The console Resources page: every resource with its labels, the roles that grant access, and how many workers can serve it.', cap: 'Everything Limen can reach, with the roles that grant access and the live workers that can serve it.' },
  { id: 'sessions', t: 'Sessions', alt: 'The console Sessions page: live and past sessions with filters, and a Replay link on SSH sessions.', cap: 'Live and past sessions, filtered by person, resource, kind or outcome. SSH sessions have a recording to replay.' },
  { id: 'commands', t: 'Commands', alt: 'A Redis session in the console: the command that was sent and that policy refused it.', cap: 'Database, Redis and other sessions list every command, including the ones policy refused. Values are never kept.' },
  { id: 'access', t: 'Access', alt: 'The console Access page: a request waiting for the approver, with the reason and duration.', cap: 'Approvers decide here, signed in, with the reason and the duration in front of them. Break-glass grants are flagged for review.' },
  { id: 'reviews', t: 'Reviews', alt: 'The console Reviews page: an access review in progress, a role withheld, and the evidence pack download.', cap: 'Check who holds which role, withhold what should not be there, and download a signed evidence pack for an auditor.' },
  { id: 'users', t: 'Users', alt: 'The console Users page: who has signed in, their roles, and a locked user with the reason.', cap: 'Who has signed in, and their roles. Lock a user and their open sessions end, with the reason audited.' },
  { id: 'workers', t: 'Workers', alt: 'The console Workers page: enrolled proxies and workers with their tunnels and certificate expiry.', cap: 'Enrolled proxies and workers, their tunnels and certificate expiry. Revoke one and its tunnels drop within about ten seconds.' },
  { id: 'audit', t: 'Audit trail', alt: 'The console Audit trail page: filters by kind, user and time, and a list of events.', cap: 'The last 30 days of sign-ins, denials, locks and policy changes, with search across commands and statements. Every search is recorded too.' },
  { id: 'policy', t: 'Policy', alt: 'The console Policy page: the active version and digest, and every role.', cap: 'Every policy document with its owner. Check a change before applying it: the diff, who gains or loses access, and the policy tests.' },
  { id: 'dashboards', t: 'Dashboards', alt: 'The console Dashboards page: sessions over time, sign-ins and denials, and the busiest resources and people.', cap: 'Sessions over time, sign-ins and denials, and the busiest resources and people, from the console\'s own records.' },
];
const consoleFeatures = [
  { t: 'Replay a session', d: 'Watch an SSH recording once the control plane has checked its hash. SQL, Redis and other sessions list what ran.' },
  { t: 'Approve with context', d: 'Approvers see the reason, the duration, and what the requester did on that resource in the past 30 days.' },
  { t: 'Reviews and evidence', d: 'Run access reviews and download a signed evidence pack for an auditor.' },
  { t: 'Lock and end', d: 'Lock a user or end a live session, always with a reason that goes into the audit trail.' },
  { t: 'Dashboards', d: 'Sessions over time, denials, bot sessions by repository, out-of-hours access and sessions without a recording.' },
  { t: 'Edit policy safely', d: 'Edit the documents the console owns, after checking the diff, who gains access and the policy tests.' },
];
const logoStrip = groups.flatMap((g) => g.items.flatMap((i) => i.logos.filter((l) => l.color.startsWith('#')).map((l) => ({ l, href: i.href }))));

// The ⌘K palette. Plain data, no third-party search.
---
<Site
  home
  title="Limen: access you can prove"
  description="Self-hosted, open-source access to SSH, databases, Kubernetes and internal apps. Short-lived credentials, policy as code, and an audit trail you can verify yourself."
>
      <!-- HERO -->
      <section class="hero">
        <canvas id="flow" aria-hidden="true"></canvas>
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="wrap hero-inner">
          <div class="hero-copy">
            <a class="pill" href={docs('status/')}>
              <span class="dot"></span> Open source · Apache-2.0 · self-hosted · written in Rust
            </a>
            <h1>No more static keys. Access that <span class="grad">expires in an hour</span>.</h1>
            <p class="lede">
              Limen replaces SSH keys, shared database passwords and CI secrets with <b>one sign-in</b> through your identity provider.
            </p>
            <p class="lede lede2">
              Engineers and CI jobs get <b><span class="nb">short-lived</span>, audited access</b> to SSH, databases, Kubernetes and internal apps. Every session leaves a trail <b>you can verify yourself</b>.
            </p>
            <div class="cta">
              <a class="btn primary" href={docs('quickstart/')}>Try it on your laptop
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
              <a class="btn" href={docs('')}>Read the docs</a>
            </div>
            <div class="strip" aria-label="Works with">
              <span>Works with</span>
              {logoStrip.map(({ l, href }) => <a class={`logo sm${l.wide ? ' wide' : ''}`} style={`--brand:${l.color}`} href={docs(href)} aria-label={`${l.label} guide`} title={l.label} set:html={l.svg} />)}
            </div>
          </div>

          <div class="threshold" aria-label="A doorway with a certificate that expires in an hour">
            <svg viewBox="0 0 420 500" role="img" aria-hidden="true">
              <defs>
                <linearGradient id="g-arch" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="var(--lm-accent-strong)"/><stop offset="1" stop-color="var(--lm-accent-2)"/>
                </linearGradient>
                <radialGradient id="g-light" cx="50%" cy="78%" r="65%">
                  <stop offset="0" stop-color="var(--lm-accent)" stop-opacity=".55"/><stop offset=".55" stop-color="var(--lm-accent-2)" stop-opacity=".12"/><stop offset="1" stop-color="transparent"/>
                </radialGradient>
                <filter id="f-glow" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="9"/></filter>
                <clipPath id="c-arch"><path d="M96 410 V210 a114 114 0 0 1 228 0 V410 Z"/></clipPath>
              </defs>
              <g clip-path="url(#c-arch)"><rect x="60" y="80" width="300" height="340" fill="url(#g-light)" class="light"/></g>
              <g filter="url(#f-glow)" opacity=".7"><path d="M96 410 V210 a114 114 0 0 1 228 0 V410" fill="none" stroke="url(#g-arch)" stroke-width="10" stroke-linecap="round"/></g>
              <path class="arch" d="M96 410 V210 a114 114 0 0 1 228 0 V410" fill="none" stroke="url(#g-arch)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
              <path class="arch-inner" d="M128 410 V212 a82 82 0 0 1 164 0 V410" fill="none" stroke="var(--lm-line-strong)" stroke-width="1.5" stroke-dasharray="3 7"/>
              <line x1="40" y1="438" x2="380" y2="438" stroke="var(--lm-accent)" stroke-width="7" stroke-linecap="round"/>
              <g filter="url(#f-glow)" opacity=".8"><line x1="40" y1="438" x2="380" y2="438" stroke="var(--lm-accent)" stroke-width="7" stroke-linecap="round"/></g>
              <g class="ring" transform="translate(210 300)">
                <circle r="62" fill="var(--lm-glass)" stroke="var(--lm-line-strong)" stroke-width="1.5"/>
                <circle r="62" fill="none" stroke="var(--lm-accent)" stroke-width="5" stroke-linecap="round" stroke-dasharray="389.6" stroke-dashoffset="0" transform="rotate(-90)" id="ring-arc"/>
                <text id="ttl" y="8" text-anchor="middle" class="ttl">60:00</text>
                <text y="30" text-anchor="middle" class="ttl-sub" id="ttl-sub">expires in</text>
              </g>
              <circle cx="210" cy="438" r="6" fill="var(--lm-accent-strong)" class="beacon"/>
            </svg>
            <div class="threshold-cap"><span class="live-dot"></span><span id="ttl-note">Credentials that expire. By design.</span></div>
          </div>
        </div>
      </section>

      <!-- LIVE SESSION -->
      <section class="section" id="session">
        <div class="wrap">
          <div class="eyebrow reveal">See it work</div>
          <h2 class="reveal">A session, and the proof it leaves.</h2>
          <p class="sub reveal">Every command below writes an audit event, and each event's hash includes the one before it. Edit anything in the past and the chain stops verifying. Press the tamper button and see.</p>

          <div class="theater" id="theater">
            <div class="term" role="group" aria-label="Terminal demo">
              <div class="term-bar">
                <span class="lights"><i></i><i></i><i></i></span>
                <div class="tabs" role="tablist" aria-label="Demo scenario">
                  <button role="tab" aria-selected="true" data-scn="ssh" type="button">SSH</button>
                  <button role="tab" aria-selected="false" data-scn="pg" type="button">Postgres</button>
                  <button role="tab" aria-selected="false" data-scn="k8s" type="button">Kubernetes</button>
                  <button role="tab" aria-selected="false" data-scn="req" type="button">Ask for access</button>
                </div>
                <button class="replay" id="replay" type="button" aria-label="Replay">↻ replay</button>
              </div>
              <p class="sr-only">A replayed terminal session. The audit events it produces appear in the list beside it.</p>
              <pre class="term-body" id="term" aria-hidden="true"></pre>
              <noscript><p class="noscript">Turn on JavaScript to replay this session.</p></noscript>
              <div class="term-foot">Illustrative output. The commands are real; see the <a href={docs('guides/cli/')}>CLI guide</a>.</div>
            </div>

            <div class="ledger" aria-label="Audit trail demo">
              <div class="ledger-head">
                <div>
                  <div class="ledger-title">Audit trail</div>
                  <div class="ledger-sub">each hash covers the previous one</div>
                </div>
                <div class="status ok" id="chain-status"><span class="dot"></span><span id="chain-text">chain intact</span></div>
              </div>
              <ol class="blocks" id="blocks" tabindex="0" aria-label="Audit events"></ol>
              <p class="ledger-msg" id="ledger-msg" aria-live="polite"></p>
              <div class="ledger-actions">
                <button class="btn small danger" id="tamper" type="button" disabled>✎ Tamper with an event</button>
                <button class="btn small" id="restore" type="button" disabled>Restore</button>
              </div>
              <p class="ledger-note">A simplified picture of the idea. The real trail is batched, signed, and chained per writer in S3, and <code>limen audit verify</code> walks it.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- CONSOLE -->
      <section class="section" id="console">
        <div class="wrap">
          <div class="eyebrow reveal">The console</div>
          <h2 class="reveal">Prefer a browser? The console has it.</h2>
          <p class="sub reveal">The same identity provider and the same policy, in a web console the proxy serves. Look around, replay sessions, approve requests and make the occasional admin change. Your roles decide what you see, and everything you change is audited as you.</p>

          <div class="shotbox reveal">
            <div class="term-bar">
              <span class="lights"><i></i><i></i><i></i></span>
              <div class="tabs" role="tablist" aria-label="Console pages">
                {consolePages.map((pg, i) => <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-pg={pg.id} type="button">{pg.t}</button>)}
              </div>
            </div>
            {consolePages.map((pg, i) => (
              <figure class="shot" data-panel={pg.id} hidden={i > 0}>
                <div class="shot-img">
                  <img class="dark" src={`${base}console/${pg.id}-dark.jpg`} width="2000" height="1027" loading={i > 0 ? 'lazy' : undefined} alt={pg.alt} />
                  <img class="light" src={`${base}console/${pg.id}-light.jpg`} width="2000" height="1027" loading={i > 0 ? 'lazy' : undefined} alt={pg.alt} />
                </div>
                <figcaption>{pg.cap}</figcaption>
              </figure>
            ))}
            <p class="shot-note">The real console, with sample data.<span class="swipe"> Swipe the picture to look around.</span></p>
          </div>

          <ul class="cfeat">
            {consoleFeatures.map((f) => (
              <li class="reveal"><b>{f.t}</b><span>{f.d}</span></li>
            ))}
          </ul>
          <div class="diagram-link reveal"><a href={docs('guides/console/')}>The console guide →</a></div>
        </div>
      </section>

      <!-- MCP -->
      <section class="section" id="mcp">
        <div class="wrap">
          <div class="eyebrow reveal">AI assistants</div>
          <h2 class="reveal">Ask your assistant what you can reach.</h2>
          <p class="sub reveal"><code>limen mcp</code> is a read-only MCP server built into the CLI. It uses your own login, so it grants nothing you don't already have.</p>
          <div class="mcp">
            <div class="mcp-text">
              <div class="mcp-col reveal">
                <h3>It can answer</h3>
                <ul class="plist">
                  <li>Who you are, your roles, and when your login ends.</li>
                  <li>What you can reach, and how to connect to it.</li>
                  <li>Why you can't reach something, and what would let you.</li>
                </ul>
              </div>
              <div class="mcp-col reveal">
                <h3>It cannot</h3>
                <ul class="plist no">
                  <li>Connect, request, approve, lock or change anything. To get access you run <code>limen request</code> yourself, and a person approves it.</li>
                  <li>Sign in for you. When your login expires it says <code>run limen login</code>.</li>
                </ul>
              </div>
            </div>
            <div class="mcp-side reveal">
              <div class="install">
                <div class="install-bar"><span>terminal</span></div>
<pre tabindex="0"><span class="p">$</span> limen login
<span class="p">$</span> claude mcp add --scope user \
    limen -- limen mcp</pre>
              </div>
              <ul class="chips tools" aria-label="The five read-only tools">
                <li>limen_status</li><li>limen_ls</li><li>limen_show</li><li>limen_explain</li><li>limen_requests</li>
              </ul>
              <p class="mcp-note">Early and read-only. The audit trail shows you, not the assistant: its calls are your calls.</p>
            </div>
          </div>
          <div class="diagram-link reveal"><a href={docs('guides/ai-agents/')}>Use Limen from an AI assistant →</a></div>
        </div>
      </section>

      <!-- HOW -->
      <section class="section" id="how">
        <div class="wrap">
          <div class="eyebrow reveal">How it works</div>
          <h2 class="reveal">What happens when you connect.</h2>
          <ol class="steps" id="steps">
            {steps.map((s) => (
              <li class="step reveal">
                <div class="step-n">{s.n}</div>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
                <code>{s.c}</code>
                {s.n === '04' && <div class="minichain" aria-hidden="true"><i></i><i></i><i></i><i></i><i class="head"></i></div>}
              </li>
            ))}
          </ol>
          <div class="diagram-link reveal">
            <a href={docs('architecture/diagrams/')}>See the architecture diagrams →</a>
          </div>
        </div>
      </section>

      <!-- WHO -->
      <section class="section" id="who">
        <div class="wrap">
          <div class="eyebrow reveal">Who it is for</div>
          <h2 class="reveal">For the people who get paged, and the people who get audited.</h2>
          <div class="people">
            <article class="person reveal">
              <div class="person-top"><span class="pico" set:html={ico.dev} /><span class="who-tag">Developers</span></div>
              <h3>Get in, get on with it.</h3>
              <ul class="plist">
                <li>Sign in once. <code>limen ls</code> shows what you can reach.</li>
                <li>Keep using <code>ssh</code>, <code>psql</code> and <code>kubectl</code>, with no keys or passwords to look after.</li>
                <li>Need more? Ask for it, with a reason.</li>
              </ul>
              <a class="more" href={docs('guides/cli/')}>The CLI →</a>
            </article>
            <article class="person reveal">
              <div class="person-top"><span class="pico" set:html={ico.ops} /><span class="who-tag">Platform and SRE</span></div>
              <h3>Run it like the rest of your stack.</h3>
              <ul class="plist">
                <li>Policy in Git, tested in CI.</li>
                <li>Workers dial out, so you open no inbound holes.</li>
                <li>Several copies of each part behind a load balancer.</li>
                <li>Prometheus metrics, OpenTelemetry traces, ready-made alerts.</li>
              </ul>
              <a class="more" href={docs('guides/scale-out/')}>Running at scale →</a>
            </article>
            <article class="person reveal">
              <div class="person-top"><span class="pico" set:html={ico.sec} /><span class="who-tag">Security and compliance</span></div>
              <h3>Evidence, not promises.</h3>
              <ul class="plist">
                <li>A signed, hash-chained trail.</li>
                <li>Recordings checked before playback.</li>
                <li>Access reviews with signed evidence packs.</li>
                <li>A threat model you can read before you trust it.</li>
              </ul>
              <a class="more" href={docs('architecture/threat-model/')}>The threat model →</a>
            </article>
          </div>
        </div>
      </section>

      <!-- PILLARS -->
      <section class="section" id="why">
        <div class="wrap">
          <div class="eyebrow reveal">Why Limen</div>
          <h2 class="reveal">A door that keeps a record you can check.</h2>
          <p class="sub reveal">Knowing who got in is the easy part. Limen leaves evidence that someone who doesn't trust it can check.</p>
          <div class="bento">
            <article class="card w4 reveal">
              <div class="pillar">Provable</div>
              <h3><span class="ico" set:html={ico.chain} /> A trail you can check yourself</h3>
              <p>Audit events are signed and chained. Delete or alter one, and verification fails.</p>
              <pre class="snip one"><span class="p">$</span> limen audit verify
<span class="ok out">OK: every batch is present, unmodified, signed, and chained</span></pre>
              <div class="minichain" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i class="head"></i></div>
              <a class="more" href={docs('runbooks/audit-verify/')}>Verifying the chain →</a>
            </article>
            <article class="card reveal">
              <div class="pillar">Explainable</div>
              <h3><span class="ico" set:html={ico.test} /> Know why, before anyone asks</h3>
              <p>Policy is YAML in Git, tested in CI. See how a change widens access before it ships.</p>
              <pre class="snip one"><span class="p">$</span> limen policy test policy/
<span class="p">$</span> limen explain orders-prod</pre>
              <a class="more" href={docs('guides/policy-tooling/')}>Policy tooling →</a>
            </article>
            <article class="card half reveal">
              <div class="pillar">Short-lived</div>
              <h3><span class="ico" set:html={ico.clock} /> Access that ends when the need does</h3>
              <p>Ask with a reason. When the grant ends, so do the sessions it allowed.</p>
              <pre class="snip one"><span class="p">$</span> limen request orders-prod --for 30m</pre>
              <div class="grant" aria-hidden="true"><div class="grant-track"><i></i></div><div class="grant-row"><span>30m grant</span><span class="grant-end">0:00 · sessions close</span></div></div>
              <a class="more" href={docs('guides/access-requests/')}>Requests and break-glass →</a>
            </article>
            <article class="card half reveal">
              <div class="pillar">Machines are principals too</div>
              <h3><span class="ico" set:html={ico.bot} /> Pipelines get identities, not secrets</h3>
              <p>A CI job signs in with its own token and gets a short-lived bot login. Nothing long-lived sits in the repository.</p>
              <pre class="snip one"><span class="p">$</span> limen login --bot github_actions</pre>
              <ol class="flow" aria-hidden="true"><li>CI token</li><li>bot login</li><li>audit event <small>+ run id</small></li></ol>
              <a class="more" href={docs('guides/bots/')}>Bots →</a>
            </article>
            <article class="card mini reveal">
              <h3><span class="ico" set:html={ico.rec} /> Replays you can trust</h3>
              <p>Each recording's hash is in the audit trail, and checked before playback.</p>
              <a class="more" href={docs('guides/console/')}>Replaying a session →</a>
            </article>
            <article class="card mini reveal">
              <h3><span class="ico" set:html={ico.pack} /> Evidence in one file</h3>
              <p>Export a signed pack. An auditor checks it offline, with just your CA certificate.</p>
              <a class="more" href={docs('guides/access-reviews/')}>Reviews and evidence →</a>
            </article>
            <article class="card mini reveal">
              <h3><span class="ico" set:html={ico.stop} /> Cut access off, and say why</h3>
              <p>Lock a user and their sessions end within about ten seconds. Or end one live session. The reason is audited.</p>
              <a class="more" href={docs('guides/console/')}>The console →</a>
            </article>
            <article class="card full reveal plain">
              <h3><span class="ico" set:html={ico.open} /> The whole thing, in the open</h3>
              <p>Approvals, auditing, discovery and reviews are all in the Apache-2.0 build, with no paid tier.</p>
              <ul class="chips">
                <li>Apache-2.0</li><li>Rust, static binaries</li><li>PostgreSQL only</li><li>Outbound-only workers</li><li>Docker Compose to try it</li><li>Terraform modules <em>(unverified on AWS)</em></li><li>Prometheus and OpenTelemetry</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <!-- PROTOCOLS -->
      <section class="section" id="protocols">
        <div class="wrap">
          <div class="eyebrow reveal">What it connects to</div>
          <h2 class="reveal">One policy and one audit trail for all of it.</h2>
          <p class="sub reveal">Every tile is tested against a local copy of the software. A tile marked <span class="chip warn">unverified</span> also has a cloud-specific path that is written but has not yet run against the real service.</p>
          <div class="pfilter" role="group" aria-label="Filter integrations by what has been verified">
            <button type="button" aria-pressed="true" data-f="all">All</button>
            <button type="button" aria-pressed="false" data-f="verified">Nothing unverified</button>
            <button type="button" aria-pressed="false" data-f="unverified">Has unverified paths</button>
            <span class="pcount" id="pcount" aria-live="polite"></span>
          </div>
          {groups.map((g) => (
            <div class="pgroup">
              <div class="pgroup-head"><h3>{g.title}</h3><p>{g.blurb}</p></div>
              <div class="protos">
                {g.items.map((p) => (
                  <a class="proto reveal" href={docs(p.href)} data-status={p.warn ? 'unverified' : 'verified'}>
                    <span class="proto-top">
                      <span class="logos">
                        {p.logos.map((l) => <span class={`logo${l.wide ? ' wide' : ''}`} style={`--brand:${l.color}`} role="img" aria-label={l.label} set:html={l.svg} />)}
                      </span>
                    </span>
                    <span class="pname">{p.name}</span>
                    <span class="psub">{p.sub}</span>
                    {p.warn ? <span class="pwarn"><i aria-hidden="true"></i><span><b>Unverified:</b> {p.warn}</span></span> : <span class="pwarn ok"><i aria-hidden="true"></i><span>Tested locally</span></span>}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- HONESTY -->
      <section class="section honest" id="honest">
        <div class="wrap">
          <div class="honest-card reveal">
            <div class="honest-text">
              <div class="honest-mark" aria-hidden="true">!</div>
              <h2>We tell you what isn't proven.</h2>
              <p>Limen is tested thoroughly against local stand-ins. <b>It has not yet been verified against real AWS, Okta or Datadog.</b> Those checks are on the roadmap, one issue per service, and every page that describes a capability says whether it has met the real thing.</p>
              <div class="cta left">
                <a class="btn" href={docs('status/')}>The status page</a>
                <a class="btn ghost" href={`${GH}/milestone/21`}>Verification roadmap</a>
              </div>
            </div>
            <ul class="verify" aria-label="Verification status">
              <li class="y"><span class="mark" aria-hidden="true">✔</span><span>Local stand-ins: Dex, databases and brokers in containers, local S3 and KMS</span><em>tested</em></li>
              <li class="n"><span class="mark" aria-hidden="true">○</span><span>Real AWS: RDS, EKS, MSK, KMS and more</span><em>not yet</em></li>
              <li class="n"><span class="mark" aria-hidden="true">○</span><span>Real Okta</span><em>not yet</em></li>
              <li class="n"><span class="mark" aria-hidden="true">○</span><span>Real Datadog</span><em>not yet</em></li>
            </ul>
          </div>
        </div>
      </section>

      <!-- START -->
      <section class="section start" id="start">
        <div class="wrap narrow">
          <div class="eyebrow reveal">Try it</div>
          <h2 class="reveal">From clone to a recorded session, on your laptop.</h2>
          <div class="install">
            <div class="install-bar"><span>terminal</span><button class="copy" id="copy" type="button">Copy</button></div>
<pre id="install-code" tabindex="0"><span class="p">$</span> git clone https://github.com/limen-dev/limen &amp;&amp; cd limen
<span class="p">$</span> deploy/compose/setup.sh
<span class="p">$</span> scripts/install-cli.sh
<span class="p">$</span> limen --proxy localhost:3443 login --ca-file deploy/compose/.state/internal-ca.pem
<span class="p">$</span> limen ssh web-staging-1</pre>
          </div>
          <p class="fineprint">Needs Docker and the tools in <code>mise.toml</code>. The first build takes several minutes. This is a local stack with test users and passwords, not for production.</p>
          <div class="cta"><a class="btn primary" href={docs('quickstart/')}>Read the quickstart</a><a class="btn" href={`${GH}`}>Star on GitHub</a></div>
        </div>
      </section>
