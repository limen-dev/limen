---
import '@fontsource-variable/geist/index.css';
import '@fontsource-variable/geist-mono/index.css';
import '../styles/tokens.css';
import '../styles/landing.css';
import { GH, ghPath, docsUrl, paletteFor } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** The homepage, whose nav links are on-page anchors. */
  home?: boolean;
  noindex?: boolean;
}
const { title, description, home = false, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const docs = (p: string) => docsUrl(base, p);
const palette = paletteFor(base);
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#05080f" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(`${base}og.png`, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:description" content={description} />
    <script is:inline>
      // Same storage key as the docs, so the choice follows you between the two.
      try {
        var t = localStorage.getItem('starlight-theme');
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav" id="nav">
      <a class="brand" href={base} aria-label="Limen home">
        <svg viewBox="0 0 256 256" aria-hidden="true"><path d="M64 192 V112 a64 64 0 0 1 128 0 V192" fill="none" stroke="currentColor" stroke-width="20" stroke-linecap="round" stroke-linejoin="round"/><line x1="36" y1="220" x2="220" y2="220" stroke="var(--lm-accent)" stroke-width="14" stroke-linecap="round"/><circle cx="128" cy="140" r="15" fill="var(--lm-accent)"/></svg>
        <span>limen</span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href={`${home ? '' : base}#session`}>Live demo</a>
        <a href={`${home ? '' : base}#how`}>How it works</a>
        <a href={`${home ? '' : base}#who`}>Who it's for</a>
        <a href={`${home ? '' : base}#protocols`}>Protocols</a>
        <a href={docs('')}>Docs</a>
      </nav>
      <div class="nav-actions">
        <button class="kbd-btn" id="open-palette" type="button" aria-label="Search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <span>Search</span><kbd>⌘K</kbd>
        </button>
        <button class="icon-btn" id="theme" type="button" aria-label="Toggle light and dark theme">
          <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        <a class="icon-btn" href={GH} aria-label="Limen on GitHub">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d={ghPath} fill="currentColor" stroke="none"/></svg>
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap foot">
        <div class="foot-brand">
          <a class="brand" href={base}><svg viewBox="0 0 256 256" aria-hidden="true"><path d="M64 192 V112 a64 64 0 0 1 128 0 V192" fill="none" stroke="currentColor" stroke-width="20" stroke-linecap="round" stroke-linejoin="round"/><line x1="36" y1="220" x2="220" y2="220" stroke="var(--lm-accent)" stroke-width="14" stroke-linecap="round"/><circle cx="128" cy="140" r="15" fill="var(--lm-accent)"/></svg><span>limen</span></a>
          <p><i>Limen</i>: Latin for “threshold”. The point you cross once you are allowed in, and the door closes behind you.</p>
        </div>
        <nav aria-label="Docs"><h2 class="foot-h">Docs</h2><a href={docs('quickstart/')}>Quickstart</a><a href={docs('concepts/')}>Concepts</a><a href={docs('guides/cli/')}>CLI</a><a href={docs('reference/policy/')}>Policy</a></nav>
        <nav aria-label="Trust"><h2 class="foot-h">Trust</h2><a href={docs('status/')}>Status</a><a href={docs('architecture/threat-model/')}>Threat model</a><a href={docs('architecture/design/')}>Design</a><a href={docs('architecture/adr/')}>Decisions</a></nav>
        <nav aria-label="Project"><h2 class="foot-h">Project</h2><a href={GH}>GitHub</a><a href={`${GH}/milestones`}>Roadmap</a><a href={`${GH}/blob/main/CONTRIBUTING.md`}>Contributing</a><a href={`${GH}/blob/main/LICENSE`}>Apache-2.0</a></nav>
      </div>
      <div class="wrap legal">Product names mentioned belong to their owners and are used only to say what Limen works with.</div>
    </footer>

    <div class="palette" id="palette" hidden>
      <div class="palette-box" role="dialog" aria-modal="true" aria-label="Search">
        <input id="palette-input" type="text" placeholder="Search the docs…" autocomplete="off" spellcheck="false" aria-label="Search the docs" />
        <ul id="palette-list" role="listbox"></ul>
        <div class="palette-foot"><span><kbd>↑</kbd><kbd>↓</kbd> move</span><span><kbd>↵</kbd> open</span><span><kbd>esc</kbd> close</span></div>
      </div>
    </div>

    <script id="palette-data" type="application/json" set:html={JSON.stringify(palette)} />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
