# Every container image the dev stack, the demos and the image builds use, in one place.
# Compose reads this file by itself (it is the project directory's .env), so
# `docker compose -f deploy/compose/docker-compose.yml ...`, setup.sh and the demos all see
# it, and the demos and scripts source it. Change a version here and nowhere else, then run
# scripts/check-versions.sh: it fails when one of the few places that cannot read this
# file (the Dockerfiles' default build args, the CI service containers, the Rust
# toolchain pins) disagrees with it. Tool versions (kubectl, kind, terraform, ...) are in
# /mise.toml.

# Limen's own backing services
POSTGRES_IMAGE=postgres:18-alpine
DEX_IMAGE=ghcr.io/dexidp/dex:v2.46.0
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.48
KMS_IMAGE=nsmithuk/local-kms@sha256:e070866476b20973a9e23a9b636204b7a222e4169a6e03198d27b80d47ed28e3

# Stand-in targets and tools
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4-alpine
VALKEY_IMAGE=valkey/valkey:8.0-alpine
K3S_IMAGE=rancher/k3s:v1.35.4-k3s1
TRINO_IMAGE=trinodb/trino:483
GRAFANA_IMAGE=grafana/grafana:13.0.2
GRAFANA_TRINO_PLUGIN=trino-datasource@1.2.0
ALPINE_IMAGE=alpine:3.22
# The SSH target's base. Not the same as ALPINE_IMAGE: it was on 3.23 when the versions were gathered here.
SSHD_BASE_IMAGE=alpine:3.23

# Base images of deploy/docker/Dockerfile (its build args default to these; the check enforces it)
RUST_IMAGE=rust:1.99.0-trixie
DISTROLESS_IMAGE=gcr.io/distroless/cc-debian13:nonroot
