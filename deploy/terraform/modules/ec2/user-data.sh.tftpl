#!/bin/bash
set -euo pipefail
dnf install -y docker jq
systemctl enable --now docker

install -d -m 0700 /etc/limen /var/lib/limen/${component}

# Plain settings.
cat > /etc/limen/env <<'ENV'
%{ for k, v in environment ~}
${k}=${v}
%{ endfor ~}
ENV

# Secrets come from Secrets Manager with the instance role, never from user data.
%{ for k, arn in secrets ~}
echo "${k}=$(aws secretsmanager get-secret-value --region ${region} --secret-id '${arn}' --query SecretString --output text)" >> /etc/limen/env
%{ endfor ~}
chmod 0600 /etc/limen/env

# SIGTERM on shutdown starts Limen's drain; systemd waits for it.
cat > /etc/systemd/system/limen.service <<'UNIT'
[Unit]
Description=Limen ${component}
After=docker.service
Requires=docker.service

[Service]
Restart=always
TimeoutStopSec=${stop_timeout}
ExecStartPre=-/usr/bin/docker rm -f limen
ExecStart=/usr/bin/docker run --rm --name limen --stop-timeout ${stop_timeout} \
  --env-file /etc/limen/env ${publish} \
  -v /var/lib/limen/${component}:/var/lib/limen/${component} \
  --log-driver awslogs --log-opt awslogs-region=${region} --log-opt awslogs-group=${log_group} \
  ${image}
ExecStop=/usr/bin/docker stop --time ${stop_timeout} limen

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now limen
